rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /pings/{pingId}/media/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    // Allow read/write for other paths if needed
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}