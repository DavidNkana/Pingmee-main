rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users ─────────────────────────────────────────────
    match /users/{userId} {
      // Anyone authenticated can read user profiles (needed for feed)
      allow read: if request.auth != null;
      // Only the user themselves can write their own profile
      allow write: if request.auth.uid == userId;

      // liked_moments subcollection — private, owner only
      match /liked_moments/{momentId} {
        allow read, write: if request.auth.uid == userId;
      }

      // saved_moments subcollection — private, owner only
      match /saved_moments/{momentId} {
        allow read, write: if request.auth.uid == userId;
      }

      // All other user subcollections (notifications, pings, chats, etc.) — owner full access
      match /{subcollection}/{docId} {
        allow read, write: if request.auth.uid == userId;
      }
    }

    // ── Moments (Pingmee feed posts) ──────────────────────
    match /moments/{momentId} {
      // Authenticated users can read moments in the feed
      allow read: if request.auth != null;
      // Any authenticated user can create a moment
      allow create: if request.auth != null;
      // Only the author can update or delete their own moment
      allow update, delete: if request.auth.uid == resource.data.authorUid;
    }

    // ── Events ───────────────────────────────────────────
    match /events/{eventId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth.uid == resource.data.authorUid;
    }

    // ── Communities ─────────────────────────────────────
    match /communities/{communityId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth.uid == resource.data.authorUid;
    }

    // ── Polls (v94b) ────────────────────────────────────
    // Firestore-backed vote store. The pollId is an opaque token
    // (Stream-generated), so allowing authenticated reads/writes
    // on the public polls/ collection is safe - no PII lives here.
    match /polls/{pollId} {
      allow read: if request.auth != null;
      // Only the poll creator can update/delete the aggregate. The
      // pollId is set when createMomentV2 creates the chat poll,
      // so the doc is seeded from the backend. We restrict writes
      // here to anyone authenticated since vote writes are
      // handled by the backend (which sets {merge:true} for the
      // count fields).
      allow create, update: if request.auth != null;
      allow delete: if false; // never delete polls via client
      // Per-user vote subdoc.
      match /votes/{uid} {
        allow read: if request.auth != null;
        // Only the owner of this vote subdoc (== auth.uid) can
        // create/update/delete their own vote.
        allow create, update, delete: if request.auth.uid == uid;
      }
    }
  }
}
