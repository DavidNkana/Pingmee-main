rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users ─────────────────────────────────────────────
    match /users/{userId} {
      // Anyone authenticated can read user profiles (needed for feed)
      allow read: if request.auth != null;
      // Only the user themselves can write their own profile
      allow write: if request.auth.uid == userId;

      // liked_moments subcollection — private, owner only
      match /liked_moments/{momentId} {
        allow read, write: if request.auth.uid == userId;
      }

      // saved_moments subcollection — private, owner only
      match /saved_moments/{momentId} {
        allow read, write: if request.auth.uid == userId;
      }
    }

    // ── Moments (Pingmee feed posts) ──────────────────────
    match /moments/{momentId} {
      // Authenticated users can read moments in the feed
      allow read: if request.auth != null;
      // Any authenticated user can create a moment
      allow create: if request.auth != null;
      // Only the author can update or delete their own moment
      allow update, delete: if request.auth.uid == resource.data.authorUid;
    }

    // ── Events ───────────────────────────────────────────
    match /events/{eventId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth.uid == resource.data.authorUid;
    }

    // ── Communities ─────────────────────────────────────
    match /communities/{communityId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth.uid == resource.data.authorUid;
    }
  }
}
